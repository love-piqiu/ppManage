<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysProjectMilestoneCustomMapper">

    <resultMap type="SysProjectMilestoneCustom" id="SysProjectMilestoneCustomResult">
        <id     property="id"              column="id"               />
        <result property="projectId"       column="project_id"       />
        <result property="milestoneName"   column="milestone_name"   />
        <result property="planDate"        column="plan_date"        />
        <result property="actualDate"      column="actual_date"      />
        <result property="sortOrder"       column="sort_order"       />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <sql id="selectMilestoneVo">
        select id, project_id, milestone_name, plan_date, actual_date, sort_order, del_flag,
               create_by, create_time, update_by, update_time
        from sys_project_milestone_custom
    </sql>

    <select id="selectByProjectId" parameterType="Long" resultMap="SysProjectMilestoneCustomResult">
        <include refid="selectMilestoneVo"/>
        where project_id = #{projectId} and del_flag = '0'
        order by sort_order asc
    </select>

    <select id="selectById" parameterType="Long" resultMap="SysProjectMilestoneCustomResult">
        <include refid="selectMilestoneVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <insert id="insert" parameterType="SysProjectMilestoneCustom" useGeneratedKeys="true" keyProperty="id">
        insert into sys_project_milestone_custom(
            <if test="projectId != null">project_id,</if>
            <if test="milestoneName != null and milestoneName != ''">milestone_name,</if>
            <if test="planDate != null">plan_date,</if>
            <if test="actualDate != null">actual_date,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="projectId != null">#{projectId},</if>
            <if test="milestoneName != null and milestoneName != ''">#{milestoneName},</if>
            <if test="planDate != null">#{planDate},</if>
            <if test="actualDate != null">#{actualDate},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="update" parameterType="SysProjectMilestoneCustom">
        update sys_project_milestone_custom
        <set>
            <if test="milestoneName != null and milestoneName != ''">milestone_name = #{milestoneName},</if>
            <if test="planDate != null">plan_date = #{planDate},</if>
            <if test="actualDate != null">actual_date = #{actualDate},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        update sys_project_milestone_custom set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteByProjectId" parameterType="Long">
        update sys_project_milestone_custom set del_flag = '2' where project_id = #{projectId}
    </delete>

</mapper>