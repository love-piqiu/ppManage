<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysPersonSkillMapper">

    <resultMap type="SysPersonSkill" id="SysPersonSkillResult">
        <id     property="id"           column="id"            />
        <result property="personId"     column="person_id"     />
        <result property="category"     column="category"      />
        <result property="skill"        column="skill"         />
        <result property="source"       column="source"        />
        <result property="delFlag"      column="del_flag"      />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectPersonSkillVo">
        select id, person_id, category, skill, source, del_flag, create_by, create_time, remark
        from sys_person_skill
    </sql>

    <select id="selectPersonSkillList" parameterType="SysPersonSkill" resultMap="SysPersonSkillResult">
        <include refid="selectPersonSkillVo"/>
        <where>
            del_flag = '0'
            <if test="personId != null">
                AND person_id = #{personId}
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="skill != null and skill != ''">
                AND skill like concat('%', #{skill}, '%')
            </if>
            <if test="source != null and source != ''">
                AND source = #{source}
            </if>
        </where>
        order by category, skill
    </select>

    <select id="selectSkillByPersonId" parameterType="Long" resultMap="SysPersonSkillResult">
        <include refid="selectPersonSkillVo"/>
        where person_id = #{personId} and del_flag = '0'
        order by category, skill
    </select>

    <select id="selectPersonIdsBySkill" resultType="Long">
        select distinct person_id from sys_person_skill
        where del_flag = '0'
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        <if test="skill != null and skill != ''">
            AND skill = #{skill}
        </if>
    </select>

    <select id="selectPersonSkillById" parameterType="Long" resultMap="SysPersonSkillResult">
        <include refid="selectPersonSkillVo"/>
        where id = #{id}
    </select>

    <insert id="insertPersonSkill" parameterType="SysPersonSkill" useGeneratedKeys="true" keyProperty="id">
        insert into sys_person_skill(
            <if test="personId != null">person_id,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="skill != null and skill != ''">skill,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="personId != null">#{personId},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="skill != null and skill != ''">#{skill},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updatePersonSkill" parameterType="SysPersonSkill">
        update sys_person_skill
        <set>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="skill != null and skill != ''">skill = #{skill},</if>
            <if test="source != null and source != ''">source = #{source},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deletePersonSkillById" parameterType="Long">
        update sys_person_skill set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deletePersonSkillByIds" parameterType="Long">
        update sys_person_skill set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deletePersonSkillByPersonId" parameterType="Long">
        update sys_person_skill set del_flag = '2' where person_id = #{personId}
    </delete>

</mapper>