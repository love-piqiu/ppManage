<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysRiskMapper">

    <resultMap type="SysRisk" id="SysRiskResult">
        <id     property="id"              column="id"               />
        <result property="projectId"       column="project_id"       />
        <result property="projectName"     column="project_name"     />
        <result property="description"     column="description"      />
        <result property="level"           column="level"            />
        <result property="status"          column="status"           />
        <result property="measure"         column="measure"          />
        <result property="ownerId"         column="owner_id"         />
        <result property="ownerName"       column="owner_name"       />
        <result property="happenDate"      column="happen_date"      />
        <result property="resolveDate"     column="resolve_date"     />
        <result property="remark"          column="remark"           />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <sql id="selectRiskVo">
        select id, project_id, project_name, description, level, status, measure,
               owner_id, owner_name, happen_date, resolve_date,
               remark, del_flag, create_by, create_time, update_by, update_time
        from sys_risk
    </sql>

    <select id="selectRiskList" parameterType="SysRisk" resultMap="SysRiskResult">
        <include refid="selectRiskVo"/>
        where del_flag = '0'
        <if test="projectId != null">
            AND project_id = #{projectId}
        </if>
        <if test="projectName != null and projectName != ''">
            AND project_name like concat('%', #{projectName}, '%')
        </if>
        <if test="level != null and level != ''">
            AND level = #{level}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="ownerId != null">
            AND owner_id = #{ownerId}
        </if>
        order by level desc, create_time desc
    </select>

    <select id="selectRiskById" parameterType="Long" resultMap="SysRiskResult">
        <include refid="selectRiskVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectActiveByProjectId" parameterType="Long" resultMap="SysRiskResult">
        <include refid="selectRiskVo"/>
        where project_id = #{projectId} and del_flag = '0'
              and status in ('潜在', '已发生')
        order by level desc, create_time desc
    </select>

    <insert id="insertRisk" parameterType="SysRisk" useGeneratedKeys="true" keyProperty="id">
        insert into sys_risk(
            <if test="projectId != null">project_id,</if>
            <if test="projectName != null and projectName != ''">project_name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="level != null and level != ''">level,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="measure != null and measure != ''">measure,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null and ownerName != ''">owner_name,</if>
            <if test="happenDate != null">happen_date,</if>
            <if test="resolveDate != null">resolve_date,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="projectId != null">#{projectId},</if>
            <if test="projectName != null and projectName != ''">#{projectName},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="level != null and level != ''">#{level},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="measure != null and measure != ''">#{measure},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null and ownerName != ''">#{ownerName},</if>
            <if test="happenDate != null">#{happenDate},</if>
            <if test="resolveDate != null">#{resolveDate},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateRisk" parameterType="SysRisk">
        update sys_risk
        <set>
            <if test="projectName != null and projectName != ''">project_name = #{projectName},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="level != null and level != ''">level = #{level},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="measure != null and measure != ''">measure = #{measure},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null and ownerName != ''">owner_name = #{ownerName},</if>
            <if test="happenDate != null">happen_date = #{happenDate},</if>
            <if test="resolveDate != null">resolve_date = #{resolveDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteRiskById" parameterType="Long">
        update sys_risk set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteRiskByIds" parameterType="Long">
        update sys_risk set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteRiskByProjectId" parameterType="Long">
        update sys_risk set del_flag = '2' where project_id = #{projectId}
    </delete>

    <select id="countActiveRisk" resultType="int">
        select count(*) from sys_risk
        where del_flag = '0' and status in ('潜在', '已发生')
    </select>

    <select id="countHighLevelRisk" resultType="int">
        select count(*) from sys_risk
        where del_flag = '0' and level = '高' and status in ('潜在', '已发生')
    </select>

</mapper>