<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysIssueMapper">

    <resultMap type="SysIssue" id="SysIssueResult">
        <id     property="id"              column="id"               />
        <result property="projectId"       column="project_id"       />
        <result property="projectName"     column="project_name"     />
        <result property="description"     column="description"      />
        <result property="type"            column="type"             />
        <result property="severity"        column="severity"         />
        <result property="status"          column="status"           />
        <result property="ownerId"         column="owner_id"         />
        <result property="ownerName"       column="owner_name"       />
        <result property="discoverDate"    column="discover_date"    />
        <result property="planDate"        column="plan_date"        />
        <result property="actualDate"      column="actual_date"      />
        <result property="solution"        column="solution"         />
        <result property="remark"          column="remark"           />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <sql id="selectIssueVo">
        select id, project_id, project_name, description, type, severity, status,
               owner_id, owner_name, discover_date, plan_date, actual_date, solution,
               remark, del_flag, create_by, create_time, update_by, update_time
        from sys_issue
    </sql>

    <select id="selectIssueList" parameterType="SysIssue" resultMap="SysIssueResult">
        <include refid="selectIssueVo"/>
        where del_flag = '0'
        <if test="projectId != null">
            AND project_id = #{projectId}
        </if>
        <if test="projectName != null and projectName != ''">
            AND project_name like concat('%', #{projectName}, '%')
        </if>
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        <if test="severity != null and severity != ''">
            AND severity = #{severity}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="ownerId != null">
            AND owner_id = #{ownerId}
        </if>
        order by severity desc, create_time desc
    </select>

    <select id="selectIssueById" parameterType="Long" resultMap="SysIssueResult">
        <include refid="selectIssueVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectUnresolvedByProjectId" parameterType="Long" resultMap="SysIssueResult">
        <include refid="selectIssueVo"/>
        where project_id = #{projectId} and del_flag = '0'
              and status in ('待处理', '进行中')
        order by severity desc, create_time desc
    </select>

    <insert id="insertIssue" parameterType="SysIssue" useGeneratedKeys="true" keyProperty="id">
        insert into sys_issue(
            <if test="projectId != null">project_id,</if>
            <if test="projectName != null and projectName != ''">project_name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="severity != null and severity != ''">severity,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null and ownerName != ''">owner_name,</if>
            <if test="discoverDate != null">discover_date,</if>
            <if test="planDate != null">plan_date,</if>
            <if test="actualDate != null">actual_date,</if>
            <if test="solution != null and solution != ''">solution,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="projectId != null">#{projectId},</if>
            <if test="projectName != null and projectName != ''">#{projectName},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="severity != null and severity != ''">#{severity},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null and ownerName != ''">#{ownerName},</if>
            <if test="discoverDate != null">#{discoverDate},</if>
            <if test="planDate != null">#{planDate},</if>
            <if test="actualDate != null">#{actualDate},</if>
            <if test="solution != null and solution != ''">#{solution},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateIssue" parameterType="SysIssue">
        update sys_issue
        <set>
            <if test="projectName != null and projectName != ''">project_name = #{projectName},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="severity != null and severity != ''">severity = #{severity},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null and ownerName != ''">owner_name = #{ownerName},</if>
            <if test="discoverDate != null">discover_date = #{discoverDate},</if>
            <if test="planDate != null">plan_date = #{planDate},</if>
            <if test="actualDate != null">actual_date = #{actualDate},</if>
            <if test="solution != null and solution != ''">solution = #{solution},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIssueById" parameterType="Long">
        update sys_issue set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteIssueByIds" parameterType="Long">
        update sys_issue set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteIssueByProjectId" parameterType="Long">
        update sys_issue set del_flag = '2' where project_id = #{projectId}
    </delete>

    <select id="countUnresolvedIssue" resultType="int">
        select count(*) from sys_issue
        where del_flag = '0' and status in ('待处理', '进行中')
    </select>

    <select id="countHighSeverityIssue" resultType="int">
        select count(*) from sys_issue
        where del_flag = '0' and severity = '高' and status in ('待处理', '进行中')
    </select>

</mapper>