<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysProjectMapper">

    <resultMap type="SysProject" id="SysProjectResult">
        <id     property="id"              column="id"               />
        <result property="name"            column="name"             />
        <result property="customer"        column="customer"         />
        <result property="pmId"            column="pm_id"            />
        <result property="pmName"          column="pm_name"          />
        <result property="salesId"         column="sales_id"         />
        <result property="salesName"       column="sales_name"       />
        <result property="cost"            column="cost"             />
        <result property="costUsed"        column="cost_used"        />
        <result property="workHours"       column="work_hours"       />
        <result property="workHoursUsed"   column="work_hours_used"  />
        <result property="progress"        column="progress"         />
        <result property="stage"           column="stage"            />
        <result property="status"          column="status"           />
        <result property="isSubordinate"  column="is_subordinate"   />
        <result property="projectType"     column="project_type"     />
        <result property="startDate"       column="start_date"       />
        <result property="endDate"         column="end_date"         />
        <result property="reqPlanDate"     column="req_plan_date"    />
        <result property="reqActualDate"   column="req_actual_date"  />
        <result property="uatPlanDate"     column="uat_plan_date"    />
        <result property="uatActualDate"   column="uat_actual_date"  />
        <result property="launchPlanDate"  column="launch_plan_date" />
        <result property="launchActualDate" column="launch_actual_date" />
        <result property="acceptPlanDate"  column="accept_plan_date" />
        <result property="acceptActualDate" column="accept_actual_date" />
        <result property="actualEndDate"   column="actual_end_date"  />
        <result property="remark"          column="remark"           />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="contractAmount"  column="contract_amount"  />
        <result property="invoicedAmount"  column="invoiced_amount"  />
        <result property="issueCount"      column="issue_count"      />
        <result property="riskCount"       column="risk_count"       />
        <result property="personCount"     column="person_count"     />
    </resultMap>

    <sql id="selectProjectVo">
        select p.id, p.name, p.customer, p.pm_id, p.pm_name, p.sales_id, p.sales_name,
               p.cost, p.cost_used, p.work_hours, p.work_hours_used, p.progress, p.stage, p.status,
               p.is_subordinate, p.project_type,
               p.start_date, p.end_date,
               p.req_plan_date, p.req_actual_date, p.uat_plan_date, p.uat_actual_date,
               p.launch_plan_date, p.launch_actual_date, p.accept_plan_date, p.accept_actual_date,
               p.actual_end_date,
               p.contract_amount, p.remark, p.del_flag,
               p.create_by, p.create_time, p.update_by, p.update_time,
               (select COALESCE(sum(amount), 0) from sys_project_invoice where project_id = p.id) as invoiced_amount,
               (select count(*) from sys_issue where project_id = p.id and del_flag = '0' and status != '已关闭') as issue_count,
               (select count(*) from sys_risk where project_id = p.id and del_flag = '0' and status != '已消除') as risk_count,
               (select count(distinct person_id) from sys_person_project where project_id = p.id) as person_count
        from sys_project p
    </sql>

    <select id="selectProjectList" parameterType="SysProject" resultMap="SysProjectResult">
        <include refid="selectProjectVo"/>
        where p.del_flag = '0'
        <if test="keyword != null and keyword != ''">
            AND (p.name like concat('%', #{keyword}, '%') OR p.customer like concat('%', #{keyword}, '%'))
        </if>
        <if test="name != null and name != ''">
            AND p.name like concat('%', #{name}, '%')
        </if>
        <if test="customer != null and customer != ''">
            AND p.customer like concat('%', #{customer}, '%')
        </if>
        <if test="pmId != null">
            AND p.pm_id = #{pmId}
        </if>
        <if test="salesId != null">
            AND p.sales_id = #{salesId}
        </if>
        <if test="status != null and status != ''">
            AND p.status = #{status}
        </if>
        <if test="stage != null and stage != ''">
            AND p.stage like concat('%', #{stage}, '%')
        </if>
        order by p.start_date desc
    </select>

    <select id="selectProjectAll" resultMap="SysProjectResult">
        <include refid="selectProjectVo"/>
        where p.del_flag = '0'
        order by p.name
    </select>

    <select id="selectProjectById" parameterType="Long" resultMap="SysProjectResult">
        <include refid="selectProjectVo"/>
        where p.id = #{id} and p.del_flag = '0'
    </select>

    <select id="selectProjectByName" parameterType="String" resultMap="SysProjectResult">
        <include refid="selectProjectVo"/>
        where p.name = #{name} and p.del_flag = '0' limit 1
    </select>

    <select id="checkNameUnique" parameterType="String" resultMap="SysProjectResult">
        <include refid="selectProjectVo"/>
        where p.name = #{name} and p.del_flag = '0' limit 1
    </select>

    <insert id="insertProject" parameterType="SysProject" useGeneratedKeys="true" keyProperty="id">
        insert into sys_project(
            <if test="name != null and name != ''">name,</if>
            <if test="customer != null and customer != ''">customer,</if>
            <if test="pmId != null">pm_id,</if>
            <if test="pmName != null and pmName != ''">pm_name,</if>
            <if test="salesId != null">sales_id,</if>
            <if test="salesName != null and salesName != ''">sales_name,</if>
            <if test="cost != null">cost,</if>
            <if test="costUsed != null">cost_used,</if>
            <if test="workHours != null">work_hours,</if>
            <if test="workHoursUsed != null">work_hours_used,</if>
            <if test="progress != null">progress,</if>
            <if test="stage != null and stage != ''">stage,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="isSubordinate != null and isSubordinate != ''">is_subordinate,</if>
            <if test="projectType != null and projectType != ''">project_type,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="reqPlanDate != null">req_plan_date,</if>
            <if test="reqActualDate != null">req_actual_date,</if>
            <if test="uatPlanDate != null">uat_plan_date,</if>
            <if test="uatActualDate != null">uat_actual_date,</if>
            <if test="launchPlanDate != null">launch_plan_date,</if>
            <if test="launchActualDate != null">launch_actual_date,</if>
            <if test="acceptPlanDate != null">accept_plan_date,</if>
            <if test="acceptActualDate != null">accept_actual_date,</if>
            <if test="actualEndDate != null">actual_end_date,</if>
            <if test="contractAmount != null">contract_amount,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="name != null and name != ''">#{name},</if>
            <if test="customer != null and customer != ''">#{customer},</if>
            <if test="pmId != null">#{pmId},</if>
            <if test="pmName != null and pmName != ''">#{pmName},</if>
            <if test="salesId != null">#{salesId},</if>
            <if test="salesName != null and salesName != ''">#{salesName},</if>
            <if test="cost != null">#{cost},</if>
            <if test="costUsed != null">#{costUsed},</if>
            <if test="workHours != null">#{workHours},</if>
            <if test="workHoursUsed != null">#{workHoursUsed},</if>
            <if test="progress != null">#{progress},</if>
            <if test="stage != null and stage != ''">#{stage},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="isSubordinate != null and isSubordinate != ''">#{isSubordinate},</if>
            <if test="projectType != null and projectType != ''">#{projectType},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="reqPlanDate != null">#{reqPlanDate},</if>
            <if test="reqActualDate != null">#{reqActualDate},</if>
            <if test="uatPlanDate != null">#{uatPlanDate},</if>
            <if test="uatActualDate != null">#{uatActualDate},</if>
            <if test="launchPlanDate != null">#{launchPlanDate},</if>
            <if test="launchActualDate != null">#{launchActualDate},</if>
            <if test="acceptPlanDate != null">#{acceptPlanDate},</if>
            <if test="acceptActualDate != null">#{acceptActualDate},</if>
            <if test="actualEndDate != null">#{actualEndDate},</if>
            <if test="contractAmount != null">#{contractAmount},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateProject" parameterType="SysProject">
        update sys_project
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="customer != null and customer != ''">customer = #{customer},</if>
            <if test="pmId != null">pm_id = #{pmId},</if>
            <if test="pmName != null and pmName != ''">pm_name = #{pmName},</if>
            <if test="salesId != null">sales_id = #{salesId},</if>
            <if test="salesName != null and salesName != ''">sales_name = #{salesName},</if>
            <if test="cost != null">cost = #{cost},</if>
            <if test="costUsed != null">cost_used = #{costUsed},</if>
            <if test="workHours != null">work_hours = #{workHours},</if>
            <if test="workHoursUsed != null">work_hours_used = #{workHoursUsed},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="stage != null and stage != ''">stage = #{stage},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="isSubordinate != null and isSubordinate != ''">is_subordinate = #{isSubordinate},</if>
            <if test="projectType != null and projectType != ''">project_type = #{projectType},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="reqPlanDate != null">req_plan_date = #{reqPlanDate},</if>
            <if test="reqActualDate != null">req_actual_date = #{reqActualDate},</if>
            <if test="uatPlanDate != null">uat_plan_date = #{uatPlanDate},</if>
            <if test="uatActualDate != null">uat_actual_date = #{uatActualDate},</if>
            <if test="launchPlanDate != null">launch_plan_date = #{launchPlanDate},</if>
            <if test="launchActualDate != null">launch_actual_date = #{launchActualDate},</if>
            <if test="acceptPlanDate != null">accept_plan_date = #{acceptPlanDate},</if>
            <if test="acceptActualDate != null">accept_actual_date = #{acceptActualDate},</if>
            <if test="actualEndDate != null">actual_end_date = #{actualEndDate},</if>
            <if test="contractAmount != null">contract_amount = #{contractAmount},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteProjectById" parameterType="Long">
        update sys_project set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteProjectByIds" parameterType="Long">
        update sys_project set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countActiveProject" resultType="int">
        select count(*) from sys_project where status = '进行中' and del_flag = '0'
    </select>

    <select id="countCompletedProject" resultType="int">
        select count(*) from sys_project where status = '已完成' and del_flag = '0'
    </select>

</mapper>